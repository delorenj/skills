#!/usr/bin/env python3
"""Deterministic controller for the DeLoNET Daily Report.

Exit codes are part of the contract, because the failure this package exists to
prevent was a scheduler recording success over a command that did not run:

    0  the command did what it says it did
    2  configuration, contract, or I/O error
    3  the run or the published artifact did not meet its acceptance check

Nothing here ever prints a status it did not derive from a file it read.
"""

from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path
from typing import Any

sys.path.insert(0, str(Path(__file__).resolve().parent))

from reportctl_archive import (
    archive_report,
    artifact_health,
    derive_status,
    manifest_health,
    section_path,
    verify_published,
)
from distribute import distribute
from reportctl_cli import build_parser
from reportctl_config import load_config
from reportctl_contracts import ConfigError, active_section_ids, required_section_ids
from reportctl_runtime import archive_paths, atomic_write
from run import EXIT_ERROR, EXIT_OK, EXIT_UNMET, collect_sections, command_run, new_run_id


def command_status(config: dict[str, Any], date: str) -> dict[str, Any]:
    sections = artifact_health(config, date)
    manifest = manifest_health(config, date)
    published = verify_published(config, date)
    statuses = {item["id"]: item["status"] for item in sections}
    return {
        "date": date,
        "configured_sections": len(config["sections"]),
        "enabled_sections": active_section_ids(config),
        "required_sections": required_section_ids(config),
        "derived_status": derive_status(config, statuses),
        "manifest": manifest,
        "sections": sections,
        "published": published,
        "healthy": published["ok"] and published.get("status") == "complete",
    }


def command_distribute(config: dict[str, Any], args: Any) -> tuple[dict[str, Any], int]:
    """Deliver the generation ``current.json`` names -- and only that one.

    Distribution reads the published artifact rather than whatever a run left
    in memory, so a report can be re-delivered later without re-running
    collection, and so a generation that never verified is never sent.
    """
    published = verify_published(config, args.date)
    if not published["coherent"]:
        return (
            {
                "date": args.date,
                "ok": False,
                "error": "nothing coherent is published for this date; run `reportctl run` first",
                "problems": published.get("problems", []),
            },
            EXIT_UNMET,
        )

    generation = Path(published["generation"])
    markdown = (generation / "report.md").read_text(encoding="utf-8")
    report = json.loads((generation / "report.json").read_text(encoding="utf-8"))

    result = distribute(
        config,
        args.date,
        markdown,
        report,
        published.get("status", "unknown"),
        report.get("run_id", ""),
        only=args.only or None,
        dry_run=args.dry_run,
    )
    result["generation"] = published.get("generation_id")
    return result, (EXIT_OK if result["ok"] else EXIT_UNMET)


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        config_path = Path(args.config).expanduser()
        config = load_config(config_path)
        exit_code = EXIT_OK

        if args.command == "validate":
            output: Any = {
                "valid": True,
                "version": config["version"],
                "sections": len(config["sections"]),
                "enabled_sections": active_section_ids(config),
                "required_sections": required_section_ids(config),
                "project_roots": len(config["project_roots"]),
                "narrator_enabled": config["narrator"]["enabled"],
            }
        elif args.command == "paths":
            output = archive_paths(config, args.date)
        elif args.command == "status":
            output = command_status(config, args.date)
        elif args.command == "collect":
            run_id = args.run_id or new_run_id(args.date)
            entries = collect_sections(config, args.date, args.section, run_id)
            incomplete = [item["id"] for item in entries if item["status"] != "complete"]
            output = {
                "date": args.date,
                "run_id": run_id,
                "sections": entries,
                "incomplete": incomplete,
            }
            exit_code = EXIT_OK if not incomplete else EXIT_UNMET
        elif args.command == "run":
            output, exit_code = command_run(config, args)
        elif args.command == "verify":
            output = verify_published(config, args.date)
            if not output["ok"]:
                exit_code = EXIT_UNMET
            elif output.get("status") == "failed":
                output["problems"].append(
                    "published report status is 'failed': no section completed, so the "
                    "published artifact records a run that produced nothing"
                )
                exit_code = EXIT_UNMET
            elif args.require_complete and (
                output.get("status") != "complete" or output.get("degraded")
            ):
                output["problems"].append(
                    f"published report status is {output.get('status')!r} with degraded "
                    f"section(s) {output.get('degraded')}, and --require-complete was requested"
                )
                exit_code = EXIT_UNMET
        elif args.command == "distribute":
            output, exit_code = command_distribute(config, args)
        else:
            output = archive_report(config, args.report, args.markdown, args.manifest)

        print(json.dumps(output, indent=2, sort_keys=True))
        return exit_code
    except (ConfigError, OSError, subprocess.SubprocessError) as exc:
        print(json.dumps({"error": str(exc)}), file=sys.stderr)
        return EXIT_ERROR


if __name__ == "__main__":
    raise SystemExit(main())
