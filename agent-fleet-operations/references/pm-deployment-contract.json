{
  "schema_version": 3,
  "deploy_command": [
    "flume",
    "hire",
    "pm",
    "--yes"
  ],
  "rerun_command": [
    "flume",
    "onboard",
    "pm"
  ],
  "rerun_is_convergent": true,
  "rerun_force_available": false,
  "employee_rule_ids": [
    "hermes.pm-scaffold",
    "hermes.untracked-runtimes",
    "systemd.sentinel",
    "hermes.runtime-singleton",
    "hermes.fleet-config",
    "hermes.delta-list-override",
    "hermes.profile-wiring",
    "hermes.registry-parity"
  ],
  "remediate_command": [
    "flume",
    "remediate",
    "<rule-id>"
  ],
  "remediate_frozen_alias": "migrate",
  "postcondition_probe": {
    "argv": [
      "pj",
      "audit",
      "<repo>",
      "--rules",
      "mise.config-root,sot.project-json",
      "--json"
    ],
    "unreachable_probe_standing": "unableToAssess",
    "unreachable_probe_fails_hire": false
  },
  "required_skill_core": {
    "source": "~/.config/hermes-agent-template/config.toml",
    "key": "fleet.symlinked_runtime_skills",
    "resolves_to": "~/.agents/skills/<pinned-directory-name>/SKILL.md",
    "pinned_name_is_directory_not_frontmatter_name": true
  },
  "skill_policy": {
    "core_is_immutable": true,
    "configuration_may_add_optional_skills": true,
    "configuration_may_remove_core_skills": false
  },
  "preflight": {
    "reject_legacy_profile_symlink_before_mutation": true,
    "malformed_project_json": {
      "action": "abort",
      "project_json_byte_unchanged": true,
      "other_state_unchanged": true
    },
    "state_seal": {
      "before_and_after_required": true,
      "dirty_tracked_content_hashes_required": true,
      "untracked_content_hashes_required": true,
      "nested_git_required": [
        "HEAD",
        "index",
        "status",
        "dirty_content_hashes",
        "untracked_content_hashes"
      ]
    }
  },
  "runtime_exclusion": {
    "path": "agents/hermes/pm/runtime/",
    "required_checks": [
      {
        "argv": [
          "git",
          "check-ignore",
          "-q",
          "--",
          "agents/hermes/pm/runtime/"
        ],
        "expect": "exit_0"
      },
      {
        "argv": [
          "git",
          "ls-files",
          "--",
          "agents/hermes/pm/runtime/"
        ],
        "expect": "empty_stdout"
      }
    ]
  },
  "project_manifest": {
    "transaction_lock_covers": [
      "read",
      "validate",
      "board_check_or_create",
      "write"
    ],
    "replacement": "atomic",
    "plane_binding": {
      "required_state": "linked",
      "live_identifier_required": true,
      "live_board_id_required": true,
      "forbidden_persisted_keys": [
        "board_url"
      ]
    }
  },
  "profile_config_transactions": {
    "writers": [
      "initial_seed",
      "channel_adoption",
      "channel_rotation",
      "voice_reconcile",
      "render",
      "absorb",
      "recovery",
      "fleet_backfill"
    ],
    "profile_root_must_be_real": true,
    "generated_config_requires_render_marker": true,
    "generated_config_must_not_be_symlink": true,
    "delta_must_exist_and_be_regular_file": true,
    "profile_lock": {
      "shared_by_all_writers": true,
      "symlink_safe": true,
      "kernel_owned_crash_release": true,
      "finite_timeout": true,
      "nonfinite_timeout_rejected": true
    },
    "registry_lock_order": [
      "registry",
      "profile"
    ],
    "lock_before_snapshot": [
      "durable_secret_references",
      "channel_identity",
      "registry_claim",
      "role_metadata",
      "config_delta",
      "generated_config"
    ],
    "optimistic_snapshot_requires_locked_compare": true,
    "required_regressions": [
      "real_caller_voice_then_channel",
      "real_caller_channel_then_voice",
      "tokenless_adoption_and_rotation_both_orders",
      "initial_seed_and_backfill_contention",
      "truthful_timeout",
      "process_crash_release"
    ]
  },
  "validated_config_replacement": {
    "canonical_mutation_lock": {
      "scope": "whole_window",
      "named_profile_config": "per_profile_lock",
      "distributable_parent_config": "canonical_config_lock",
      "recovery_snapshot_install_share_lock": true
    },
    "serializes": [
      "stale_recovery",
      "snapshot",
      "install",
      "validation",
      "commit_or_restore",
      "cleanup"
    ],
    "same_directory_protected_recovery": true,
    "backup_like_recovery_names_forbidden": true,
    "restore_before_optional_post_restore_validation": true,
    "exact_restore": [
      "device_and_inode",
      "bytes",
      "mode",
      "mtime_ns"
    ],
    "candidate_install": "atomic",
    "recovery_and_candidate_fsync_required": true
  },
  "channels": {
    "unverified_profile_delta": {
      "platforms.telegram.enabled": false,
      "platforms.slack.enabled": false
    },
    "enable_only_after_verified_credential_ownership": true
  },
  "secrets": {
    "allowed_value_transport": [
      "pipe",
      "anonymous_fd",
      "process_memory"
    ],
    "forbidden_value_transport": [
      "curl_argv",
      "unrelated_child_environment"
    ],
    "transient_validation": {
      "preserve_previous_valid_reference_on_failure": true,
      "preserve_previous_valid_marker_on_failure": true,
      "healthy_rerun_must_recover": true
    },
    "eradication_scan_surfaces": [
      "current_text_database_cache_state",
      "git_index_and_staged_blobs",
      "local_reachable_refs",
      "local_reflogs",
      "local_unreachable_objects",
      "fetched_remote_reachable_refs"
    ],
    "authorization_required": [
      "rotation",
      "retirement",
      "private_remote_force_rewrite"
    ],
    "zero_downtime_rotation_order": [
      "inventory_consumers_and_reload_behavior",
      "create_distinct_replacement_while_old_remains_valid",
      "store_replacement_in_approved_vault",
      "update_and_reload_consumers_one_by_one",
      "verify_each_consumer_on_replacement",
      "revoke_old_credential_after_all_consumers_are_healthy",
      "verify_old_authentication_fails"
    ],
    "revoke_first": {
      "normal_rotation": false,
      "explicit_emergency_authorization_required": true,
      "outage_risk_acknowledgement_required": true,
      "recovery_plan_required": true
    },
    "private_remote_rewrite_requires": [
      "named_remote_and_ref_scope",
      "protected_rollback_refs",
      "clean_clone_scan",
      "consumer_health",
      "old_clone_invalidation"
    ]
  },
  "service_model": {
    "per_agent_units": [
      "hermes-{agent_id}-gateway.service"
    ],
    "fleet_shared_units": [
      "hermes-fleet-bloodbank-gateway.service"
    ],
    "retired_units_are_drift": [
      "hermes-{agent_id}-heartbeat.timer",
      "hermes-{agent_id}-heartbeat.service",
      "hermes-{agent_id}-consumer.service",
      "hermes-{agent_id}-checkpoint.timer"
    ],
    "heartbeat_role_yaml_state": "retired",
    "provisioning_removes_retired_heartbeat_units": true,
    "liveness_owner": "gateway unit Restart=on-failure",
    "scheduling_owner": "bloodbank",
    "persistence_owner": "krebs leases"
  },
  "service_stabilization": {
    "bounded_window_required": true,
    "single_is_active_sample_is_sufficient": false,
    "required_observations": [
      "Result",
      "ExecMainStatus",
      "NRestarts"
    ]
  },
  "registry_rerun": {
    "preserve_fields": [
      "provisioned_at"
    ],
    "preserve_extension_metadata": true,
    "preserve_unknown_fields": true,
    "byte_identical_when_inputs_unchanged": true,
    "required_bloodbank_block": {
      "gateway_scope": "fleet",
      "target_agent_id": "{agent_id}"
    },
    "forbidden_legacy_keys": [
      "consumer_unit",
      "checkpoint_timer"
    ]
  },
  "git_transactions": {
    "repository_hooks_required": true,
    "global_hooks_required": true,
    "hook_bypass_forbidden": true,
    "tracked_backup_cleanup": {
      "required_globs": [
        "*.bak",
        "*.bak-*",
        "*.orig",
        "*~",
        "*-backup.*"
      ],
      "untrack_with_git_rm_cached": true,
      "remote_tree_verification_required": true,
      "preserve_unrelated_dirty_runtime_state": true
    }
  }
}
