#!/usr/bin/env python3
"""activity-report — the only entry point of the activity-report skill.

Installed as ~/.local/bin/activity-report (a symlink made by `activity-report
init`). Resolves its own package next to the real file so the symlink chain
through ~/.agents/skills does not matter.
"""
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
if HERE not in sys.path:
    sys.path.insert(0, HERE)

from ar.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
